{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "suite-gpon",
	"version": "0.1.0",
	"identifier": "br.net.suitegpon.desktop",
	"build": {
		"frontendDist": "../ui/build",
		"devUrl": "http://127.0.0.1:1420",
		"beforeDevCommand": "npm --prefix ../ui run dev",
		"beforeBuildCommand": "npm --prefix ../ui run build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Suíte GPON/FTTH",
				"width": 1280,
				"height": 800,
				"minWidth": 900,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false,
		"targets": [],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
